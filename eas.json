{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "extends": "production",
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": false
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "autoIncrement": false
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "cache": {
        "disabled": true
      },
      "autoIncrement": true
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production-aab": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "iharshkr1@gmail.com",
        "ascAppId": "6756961183",
        "appleTeamId": "P4GUBSUMB7"
      }
    }
  }
}
